    "snapshot": v_snapshot, "snapshots": v_snapshots, "restaurer-snapshot": v_restaurer_snapshot,
    "pihole": v_pihole, "pihole-liste": v_pihole_liste, "sauvegarde": v_sauvegarde,
    "creer": v_creer, "deployer": v_deployer, "job": v_job,
}


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "_executer" and JOB_RE.match(sys.argv[2]) and os.environ.get("PHARE_JOB") == sys.argv[2]:
        executer(sys.argv[2])
        return 0
    cmd = os.environ.get("SSH_ORIGINAL_COMMAND", " ".join(sys.argv[1:])).strip()
    morceaux = cmd.split()
    if not morceaux or morceaux[0] not in VERBES or len(cmd) > 300:
        print(json.dumps({"ok": False, "erreur": "Verbe inconnu."}))
        return 1
    journal(cmd)
    try:
        res = VERBES[morceaux[0]](morceaux[1:])
        print(json.dumps({"ok": True, **(res or {})}, ensure_ascii=False))
        return 0
    except Refus as e:
        journal(f"  refus : {e}")
        print(json.dumps({"ok": False, "erreur": str(e)}, ensure_ascii=False))
        return 1
    except subprocess.TimeoutExpired:
        print(json.dumps({"ok": False, "erreur": "Délai dépassé."}))
        return 1
    except Exception as e:  # noqa: BLE001
        journal(f"  erreur : {e!r}")
        print(json.dumps({"ok": False, "erreur": "Erreur interne de l'agent (voir /var/log/phare-agent.log)."}))
        return 1


if __name__ == "__main__":
    sys.exit(main())
