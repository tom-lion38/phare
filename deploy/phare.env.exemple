# Réglages de l'interface de Phare, dans le CT : /etc/phare/phare.env
# installer.sh le crée au premier passage à partir de /etc/phare/agent.conf.
# Après une modification : systemctl restart phare
PHARE_AGENT=root@192.168.10.2
PHARE_CADDY=192.168.10.4
PHARE_HOTES=192.168.10.5,phare.lan,phare,localhost,127.0.0.1
PHARE_IP_PUBLIQUE=
PHARE_PVE_API=https://192.168.10.2:8006/api2/json
PHARE_DOMAINE_EXEMPLE=exemple.fr

# Valeurs par défaut, à changer seulement si besoin :
# PHARE_DONNEES=/var/lib/phare
# PHARE_CLE=/etc/phare/cle_agent
# PHARE_KNOWN_HOSTS=/etc/phare/known_hosts
# PHARE_PVE_JETON_ID=phare@pve!lecture
# PHARE_PVE_JETON=/etc/phare/pve-jeton
# PHARE_PVE_CA=/etc/phare/pve-ca.pem
# PHARE_DNS_PUBLIC=1.1.1.1
# PHARE_RESEAU=192.168.10
# PHARE_BLOC_SITES=120-169
# PHARE_BLOC_APPLIS=170-189
