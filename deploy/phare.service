[Unit]
Description=Phare - gestion des sites du homelab
After=network-online.target
Wants=network-online.target

[Service]
User=phare
Group=phare
WorkingDirectory=/opt/phare
Environment=PHARE_DONNEES=/var/lib/phare
Environment=PHARE_CLE=/etc/phare/cle_agent
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/phare/phare.env
ExecStart=/usr/bin/python3 -m phare --port 80
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/phare
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
